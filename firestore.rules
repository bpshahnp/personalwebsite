rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Admin check --------------------------------------------------
    // Keep this list identical to ADMIN_EMAILS in js/firebase-config.js.
    // Anyone signed in with one of these emails can write; everyone else
    // (including signed-out visitors) can only read.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          "bholashroff345@gmail.com"
        ];
    }

    // ---- Moderator check -----------------------------------------------
    function isModerator() {
      return request.auth != null && exists(/databases/$(database)/documents/moderators/$(request.auth.uid));
    }

    function modPerms() {
      return get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.permissions;
    }

    function hasClassAccess(lvl) {
      return (modPerms().mcq[lvl] == true) || 
             (modPerms().mcq[lvl].enabled == true);
    }

    // ---- Moderators collection -----------------------------------------
    // Admin can manage all moderators. Any signed-in user can check their own moderator record.
    match /moderators/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ---- Latest Updates -------------------------------------------------
    // Shown on index.html. Public read, admin or authorized moderator write.
    match /updates/{updateId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (isModerator() && modPerms().updates == true);
    }

    // ---- MCQ Hub questions ----------------------------------------------
    // Public read for learners on mcq.html.
    // In the Admin Panel:
    //   - Owner (isAdmin) sees and manages all questions.
    //   - Moderators only see questions they created (createdBy == uid).
    match /questions/{questionId} {
      // Learners: always readable
      allow read: if true;

      // Create: admin anytime; moderator with MCQ permission
      allow create: if isAdmin() || (isModerator() && (
        hasClassAccess('class8') ||
        hasClassAccess('class9') ||
        hasClassAccess('class10')
      ));

      // Update / delete: admin anytime; moderator only for their own questions
      allow update, delete: if isAdmin() ||
        (isModerator() &&
         request.auth.uid == resource.data.createdBy && (
           hasClassAccess('class8') ||
           hasClassAccess('class9') ||
           hasClassAccess('class10')
         ));
    }

    // ---- Python Hub programs ---------------------------------------------
    // Shown on python.html. Public read, admin or authorized moderator write.
    match /pythonPrograms/{programId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (isModerator() && modPerms().pythonHub == true);
    }

    // ---- Additional Resources (Google Drive links) -----------------------
    // Shown on resources.html. Public read, admin or authorized moderator write.
    match /resources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (isModerator() && modPerms().resources == true);
    }

    // ---- Contact form messages ---------------------------------------------
    // Submitted from contact.html. Anyone can SEND a message (create), but
    // only the admin can read the inbox or delete messages — visitors should
    // never be able to read other people's submissions.
    match /messages/{messageId} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // ---- MCQ leaderboard --------------------------------------------------
    // Shown on leaderboard.html. One doc per user (doc id = uid), holding
    // their personal-best quiz score. Public read (so the board is visible
    // to everyone); a user may only write to their OWN doc — no admin
    // needed here, this just stops anyone editing someone else's score.
    match /scores/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Live Quiz weekly scores -------------------------------------------
    // Shown on live.html / live-quiz.html. Public read, write by authenticated user.
    match /liveQuizScores/{scoreId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ---- Live Quiz custom questions ----------------------------------------
    // Public read, admin or authorized moderator write.
    match /liveQuizQuestions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (isModerator() && modPerms().liveQuiz == true);
    }

    // ---- Premium Quiz Content (categories + questions) --------------------
    // Public read so quiz catalog/cards can be displayed to all learners;
    // admin or authorized moderator writes.
    match /premiumQuizContent/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (isModerator() && modPerms().premiumQuiz == true);
    }

    // ---- Premium Unlock records -------------------------------------------
    // Written when a user wins the weekly tournament.
    // Each user can read/write their own doc; admin can read all.
    match /premiumUnlocks/{unlockId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---- Site Settings (min score threshold, payment keys, etc.) ----------
    // Public read so clients can load threshold & public gateway keys; admin-only write.
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- User Profiles & Credits ------------------------------------------
    // Each user manages their own profile (credits, phone number, google auth).
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ---- Payment & Credit Transaction Logs --------------------------------
    // Logs payments from eSewa and Khalti. User can create and read their own.
    match /payments/{paymentId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---- Manual Payment Verification Requests ----------------------------
    // Users submit payment proof (name, phone, ref code, screenshot).
    // User can read their own submissions, create a new submission.
    // Admin can read all, update status (approve/reject), or delete.
    match /premiumRequests/{requestId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }


    // ---- Model Account Tracker -------------------------------------------
    // Private dashboard (modeltrack.html). Admin-only read and write.
    // This collection is NOT public — tracks internal AI model accounts.
    match /modelAccounts/{docId} {
      allow read, write: if isAdmin();
    }

    // ---- Everything else: locked by default ------------------------------

    // Deny-by-default so a future collection isn't accidentally left open.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
